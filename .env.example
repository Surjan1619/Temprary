# Скопируйте в .env и задайте свои значения:  cp .env.example .env

# PostgreSQL
POSTGRES_DB=digitaldoor
POSTGRES_USER=digitaldoor
POSTGRES_PASSWORD=change-me-db-password

# Пароль для входа в админку (/admin). Используйте длинный и уникальный.
ADMIN_PASSWORD=change-me-admin-password

# Секрет для подписи сессий админки. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change-me-to-random-64-hex-chars

# true, если сайт открыт по HTTPS (за nginx/Caddy/Cloudflare)
COOKIE_SECURE=false

# Порт сайта на хосте
WEB_PORT=8080

# Только для локальной разработки без docker (npm run dev:server):
# DATABASE_URL=postgres://digitaldoor:change-me-db-password@localhost:5432/digitaldoor

# Резервные копии (сервис backup): куда класть, как часто и сколько дней хранить
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Часовой пояс статистики посещений в админке
STATS_TIMEZONE=Asia/Yerevan
